# Public-safe configuration template. Keep real values in Secret Manager or a local .env file.
PORT=8080
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE_ID=your-database-id
GOOGLE_CLOUD_REGION=your-region
CLOUD_TASKS_QUEUE=email-sends
SERVICE_BASE_URL=https://your-service-url
TASK_INVOKER_SERVICE_ACCOUNT=task-invoker@your-project.iam.gserviceaccount.com
ADMIN_API_TOKEN=store-in-secret-manager-not-here
GMAIL_CLIENT_ID_SECRET=gmail-client-id
GMAIL_CLIENT_SECRET_SECRET=gmail-client-secret
GMAIL_REFRESH_TOKEN_SECRET=gmail-refresh-token
EMAIL_ATTACHMENT_BUCKET=your-private-attachment-bucket
